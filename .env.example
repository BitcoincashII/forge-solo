# Forge Solo: settings docker-compose.yml takes from the environment. umbrelOS sets none of them: on
# Umbrel the payout address, the coinbase tag and the 1175 address are set on the app's Settings page,
# which overrides any value here. Empty means not set.
# Secrets (node RPC, DB, internal token) are generated per-install by exports.sh.

POOL_NAME=Forge Solo          # shown by the API; purely cosmetic
POOL_ADDRESS=                 # Your BCH2 (bitcoincashii:...) payout address. Every block's reward is paid here. Normally set in the dashboard Settings page instead; until one is set (either way) the stratum runs but PAUSES mining and serves no work.
COINBASE_TAG=                 # short label embedded in the coinbase of blocks you mine (<=24 printable chars); empty means Forge Solo's default, //forgesolo//
PAYOUT_ADDRESS_1175=          # your 1175 (esf1...) address, REQUIRED for 1175 merge-mining (the aux coinbase pays it directly); merge-mining stays OFF until one is set, here or in Settings
