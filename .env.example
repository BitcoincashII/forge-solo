# Forge Solo — user-facing config (set via the Umbrel app config UI).
# Secrets (node RPC, DB, internal token) are generated per-install by exports.sh.

APP_PORT=3080                 # web dashboard port
STRATUM_PORT=3333             # informational: the published port is fixed at 3333 in docker-compose.yml
POOL_NAME=Forge Solo          # shown by the API; purely cosmetic
POOL_ADDRESS=                 # Your BCH2 (bitcoincashii:...) payout address — every block's reward is paid here. Normally set in the dashboard Settings page instead; until one is set (either way) the stratum runs but PAUSES mining and serves no work.
COINBASE_TAG=Forge            # short label embedded in the coinbase of blocks you mine (<=24 printable chars)
PAYOUT_ADDRESS_1175=          # your 1175 (esf1...) address — REQUIRED for 1175 merge-mining (the aux coinbase pays it directly); merge-mining stays OFF until this is set
MIN_PAYOUT=1                  # INERT in solo — kept only because config.template.yaml still
                              # substitutes it. A solo block pays you directly in its own
                              # coinbase, so there is no balance to accumulate and no
                              # threshold to cross; nothing reads this value to gate a payout.
