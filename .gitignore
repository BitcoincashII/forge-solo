# Node daemon binaries — >100MB, exceed the GitHub file limit. For CI, fetch a
# checksum-verified release (like docker/node1175) or use Git-LFS.
docker/node/bitcoincashIId
docker/node/bitcoincashII-cli

# Backups and build/test artifacts
*.bak
*.bak-*
# `go build ./cmd/...` from the repo root drops the binary here
/forge-gateway
/forge-gateway.exe
# A gateway run from the repo root writes its identity key and log beside its config
forge-gateway.key
forge-gateway.log

# Per-install secrets (generated by exports.sh at runtime)
.env
.secrets.env
